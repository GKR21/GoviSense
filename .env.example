# ===========================================================================
# GoviSense Environment Variables
# Team DARKBITE · ModelX 2.0
# ===========================================================================

# PostgreSQL Database Connection
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/govisense

# PostgreSQL Credentials (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=govisense
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Logging
DB_ECHO=false

# District & Pilot Settings
PILOT_DISTRICT=Anuradhapura
API_PORT=8000

