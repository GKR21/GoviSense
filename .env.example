# ==============================================================================
# GoviSense Environment Configuration Template
# Copy this file to .env and adjust values for your local or production deployment.
# ==============================================================================

# Application Environment (development, staging, production, testing)
GOVISENSE_ENV=development

# Security & Authentication (JWT HS256)
# IMPORTANT: Generate a strong random key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=govisense-dev-secret-key-change-in-production-2026-sri-lanka
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (SQLite with WAL mode by default; or PostgreSQL URI)
DATABASE_URL=sqlite:///./data/govisense.db
# DATABASE_URL=postgresql://govisense_user:password@localhost:5432/govisense_db

# CORS Allowed Origins (Comma-separated list; wildcard '*' is strictly forbidden in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Agronomic Pilot Region
PILOT_DISTRICT=Anuradhapura

# Data and Models Storage Paths
DATA_DIR=./data
MODELS_DIR=./models_store

# Server Host and Port Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
LOG_LEVEL=INFO

# External Meteorological & Market API Keys (Optional overrides)
# OPEN_METEO_API_KEY=
# NASA_POWER_API_KEY=

